#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$root/.build"
qsb="${QSB:-/usr/lib/qt6/bin/qsb}"
for shader in "$root"/app/*.frag; do
  "$qsb" --glsl '100 es,120,150' --hlsl 50 --msl 12 -o "$root/.build/$(basename "$shader").qsb" "$shader"
done
