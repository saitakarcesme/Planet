#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$root/.build"
wayland-scanner client-header "$root/scripts/protocols/wlr-virtual-pointer-unstable-v1.xml" "$root/.build/pointer-protocol.h"
wayland-scanner private-code "$root/scripts/protocols/wlr-virtual-pointer-unstable-v1.xml" "$root/.build/pointer-protocol.c"
cc -O2 -Wall -Wextra -I"$root/.build" "$root/scripts/pointer.c" "$root/.build/pointer-protocol.c" $(pkg-config --cflags --libs wayland-client) -o "$root/.build/planet-pointer"
